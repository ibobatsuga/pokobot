# ==========================================
# WAHA (WhatsApp HTTP API) Cloud / VPS Configuration
# ==========================================
WAHA_BASE_URL=https://waha.domainanda.com
WAHA_SESSION_NAME=default
WAHA_API_KEY=

# ==========================================
# Sakelar AI Configuration (OpenAI-Compatible)
# ==========================================
# Endpoint resmi Sakelar AI:
SAKELAR_API_BASE_URL=https://api.sakelar.ai/v1
# Masukkan API Key dari dashboard Sakelar AI Anda:
SAKELAR_API_KEY=sk-sakelar-demo-key
# Pilihan model di Sakelar AI (misal: deepseek-chat, gpt-4o-mini, claude-3-5-sonnet, gemini-1.5-flash)
SAKELAR_MODEL=deepseek-chat

# ==========================================
# CRM & Bot Profile
# ==========================================
BOT_NAME=Poko
BUSINESS_NAME=Poko - Solusi CRM & Chatbot AI
BUSINESS_DESCRIPTION=Platform CRM dan Chatbot WhatsApp Otomatis 24 Jam untuk UMKM dan Bisnis.
BUSINESS_FAQ="1. Nama asisten AI: Poko.\n2. Jam operasional: 24/7 otomatis dijawab oleh Poko.\n3. Biaya paket: Mulai dari Rp147.000 untuk 3 bulan.\n4. Fitur utama: Broadcast massal, auto follow up, live CRM dashboard."
